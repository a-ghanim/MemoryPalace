# Database connection string (PostgreSQL)
DATABASE_URL=postgresql://user:password@localhost:5432/memory_palace

# Session secret for cookie signing (generate a random string for production)
SESSION_SECRET=your-session-secret-here

# Anthropic API key for AI-powered content parsing (optional — falls back to regex parsing)
ANTHROPIC_API_KEY=sk-ant-...

# Server port (defaults to 5000)
PORT=5000
